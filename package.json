{
  "name": "asciiquack",
  "displayName": "Asciiquack",
  "description": "A friendly ASCII duck and frog for your VS Code sidebar!",
  "version": "0.1.3",
  "publisher": "SinsuSquid",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/SinsuSquid/asciiquack.git"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onView:asciiquack.view"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "asciiquack-explorer",
          "title": "Asciiquack",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "asciiquack-explorer": [
        {
          "type": "webview",
          "id": "asciiquack.view",
          "name": "Pond"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0"
  }
}
